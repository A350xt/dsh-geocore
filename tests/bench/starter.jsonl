{"id": "B01_query_measure_parcels", "question_zh": "全市每个地块面积多大？共多少块？", "operations": [{"id": "m", "op": "query.measure", "input": "{DATA}/parcels.geojson", "measures": ["area_sqkm"]}], "expect": {"count_equals": 40}}
{"id": "B02_filter_commercial", "question_zh": "商业地块有几块？", "operations": [{"id": "f", "op": "query.filter", "input": "{DATA}/parcels.geojson", "where": "`landuse` == '商业'"}], "expect": {"count_equals_field": ["parcels_by_landuse", "商业"]}}
{"id": "B03_highway_buffer_parcels", "question_zh": "高速 1 km 范围内有多少地块？", "operations": [{"id": "h", "op": "query.filter", "input": "{DATA}/roads.geojson", "where": "`class` == '高速'"}, {"id": "b", "op": "proximity.buffer", "input": "@h", "distance_m": 1000, "dissolve": true}, {"id": "c", "op": "overlay.intersection", "a": "{DATA}/parcels.geojson", "b": "@b"}], "expect": {"count_between": [1, 39]}}
{"id": "B04_hospitals_per_district", "question_zh": "每个区有多少家医院？", "operations": [{"id": "z", "op": "zonal.summarize", "regions": "{DATA}/districts.geojson", "data": "{DATA}/hospitals.geojson", "stats": ["count"]}], "expect": {"col_sum_within_pct_of_agg": ["data_count", "counts", "hospitals", 80]}}
{"id": "B05_beds_total_per_district", "question_zh": "每区医院床位合计（应等于全市床位总数）？", "operations": [{"id": "z", "op": "zonal.summarize", "regions": "{DATA}/districts.geojson", "data": "{DATA}/hospitals.geojson", "stats": ["count", "sum"], "field": "beds"}], "expect": {"col_sum_within_pct_of_agg": ["data_beds_sum", "aggregates", "hospital_beds_total", 85], "projected_analysis": true}}
{"id": "B06_nearest_hospital_schools", "question_zh": "每所学校最近的医院是哪家、多远？", "operations": [{"id": "n", "op": "proximity.nearest", "input": "{DATA}/schools.geojson", "ref": "{DATA}/hospitals.geojson", "k": 1, "join_attrs": ["name", "beds"]}], "expect": {"count_equals": 25, "has_columns": ["nearest_distance_m", "nearest_rank", "nearest_name"]}}
{"id": "B07_poi_csv_loadable", "question_zh": "POI 表里有多少条记录（CSV 经纬度）？", "operations": [{"id": "m", "op": "query.measure", "input": "{DATA}/poi.csv", "measures": ["count"]}], "expect": {"count_equals_field_flat": ["poi"]}}
{"id": "B08_residential_in_flood", "question_zh": "洪水风险区内有多少居住地块？", "operations": [{"id": "r", "op": "query.filter", "input": "{DATA}/parcels.geojson", "where": "`landuse` == '居住'"}, {"id": "i", "op": "overlay.intersection", "a": "@r", "b": "{DATA}/flood_zone.geojson"}], "expect": {"count_between": [0, 19]}}
{"id": "B09_siting_industrial_clean", "question_zh": "找出主干道 2 km 内且不在洪水区的工业地块", "operations": [{"id": "a", "op": "query.filter", "input": "{DATA}/roads.geojson", "where": "`class` == '主干道'"}, {"id": "b", "op": "proximity.buffer", "input": "@a", "distance_m": 2000, "dissolve": true}, {"id": "p", "op": "query.filter", "input": "{DATA}/parcels.geojson", "where": "`landuse` == '工业'"}, {"id": "in", "op": "overlay.intersection", "a": "@p", "b": "@b"}, {"id": "out", "op": "overlay.difference", "a": "@in", "b": "{DATA}/flood_zone.geojson"}], "expect": {"min_count": 1, "disjoint_ref": "{DATA}/flood_zone.geojson"}}
{"id": "B10_big_candidates_arterial2km_nonflood", "question_zh": "距主干道 2 km 内、不在洪水区且面积大于 1 平方公里的候选地块有哪些？", "operations": [{"id": "a", "op": "query.filter", "input": "{DATA}/roads.geojson", "where": "`class` == '主干道'"}, {"id": "b", "op": "proximity.buffer", "input": "@a", "distance_m": 2000, "dissolve": true}, {"id": "c", "op": "overlay.intersection", "a": "{DATA}/parcels.geojson", "b": "@b"}, {"id": "d", "op": "overlay.difference", "a": "@c", "b": "{DATA}/flood_zone.geojson"}, {"id": "m", "op": "query.measure", "input": "@d", "measures": ["area_sqkm"]}, {"id": "big", "op": "query.filter", "input": "@m", "where": "area_sqkm > 1"}], "expect": {"min_count": 1, "max_count": 40, "disjoint_ref": "{DATA}/flood_zone.geojson"}}
{"id": "B11_highway_total_length", "question_zh": "境内高速总长多少公里？", "operations": [{"id": "h", "op": "query.filter", "input": "{DATA}/roads.geojson", "where": "`class` == '高速'"}, {"id": "m", "op": "query.measure", "input": "@h", "measures": ["length_km"]}], "expect": {"summary_contains_any_km": [5, 120]}}
{"id": "B12_students_per_district", "question_zh": "每区学生总数应等于全市学生总数", "operations": [{"id": "z", "op": "zonal.summarize", "regions": "{DATA}/districts.geojson", "data": "{DATA}/schools.geojson", "stats": ["count", "sum"], "field": "students"}], "expect": {"col_sum_within_pct_of_agg": ["data_students_sum", "aggregates", "school_students_total", 85]}}
{"id": "B13_secondary_roads_count", "question_zh": "次干道一共多少条？", "operations": [{"id": "f", "op": "query.filter", "input": "{DATA}/roads.geojson", "where": "`class` == '次干道'"}], "expect": {"count_equals_field": ["roads_secondary_constructed", null]}}
{"id": "B14_green_parcels", "question_zh": "绿地地块数量是多少？", "operations": [{"id": "f", "op": "query.filter", "input": "{DATA}/parcels.geojson", "where": "`landuse` == '绿地'"}], "expect": {"count_equals_field": ["parcels_by_landuse", "绿地"]}}
